# Your WhisperGraph API key - get a free one at https://console.whisper.security/sign-up
# In stdio mode this key is relayed on every request. In HTTP mode it is the
# fallback used when an inbound request carries no X-API-Key / Authorization header.
WHISPER_API_KEY=

# Transport: "stdio" (local CLI use) or "http" (remote / Docker)
MCP_TRANSPORT=stdio

# HTTP transport bind host/port (http mode only)
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Comma-separated allowlist of Host header values for DNS-rebinding protection
# (http mode). Leave empty only when a trusted gateway sits in front of the server.
# Example: WHISPER_ALLOWED_HOSTS=mcp.example.com,localhost
WHISPER_ALLOWED_HOSTS=

# Base URL of the hosted WhisperGraph API
WHISPER_DB_URL=https://graph.whisper.security

# Hard per-query deadline (ms) forwarded to the API
WHISPER_QUERY_TIMEOUT_MS=60000

# HTTP timeout (ms) for non-query calls such as /api/query/stats
WHISPER_DB_TIMEOUT_MS=10000

# Log level: debug | info | warn | error
LOG_LEVEL=info
